datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["adapterApi"]
}

model Widget {
  id        String   @id
  type      String
  title     String
  createdAt DateTime @default(now())
}

model ListenerState {
  type      String   @id
  isActive  Boolean  @default(true)
}