{
  "name": "analytics-canvas-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/server"
  ],
  "scripts": {
    "setup": "npm install && npm run db:push --workspace=apps/server",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}